# Copy to .env and replace every change-me value. Never commit .env.
POSTGRES_DB=fraudshield
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=change-me-database-password
POSTGRES_PORT=5432

JWT_SECRET=change-me-at-least-32-random-characters
GATEWAY_API_KEY=change-me-at-least-24-random-characters
AI_INTERNAL_API_KEY=change-me-internal-service-key

# Local demo accounts. The login page's quick-demo buttons sign in as these
# usernames with the password "password123", so use that value locally if you want them to work.
DEV_CARDHOLDER_USERNAME=cardholder1
DEV_ANALYST_USERNAME=analyst1
DEV_MANAGER_USERNAME=manager1
DEV_CARDHOLDER_PASSWORD=change-me-cardholder-password
DEV_ANALYST_PASSWORD=change-me-analyst-password
DEV_MANAGER_PASSWORD=change-me-manager-password

FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
